#!/bin/bash
# Omarchy for macOS - Sketchybar Config

sketchybar --bar height=32 \
                 color=0xbf0f172a \
                 border_color=0x33ffffff \
                 border_width=1 \
                 position=top \
                 blur_radius=20 \
                 padding_left=10 \
                 padding_right=10

# Default properties
sketchybar --default icon.font="JetBrains Mono:Bold:14.0" \
                     label.font="JetBrains Mono:Bold:12.0" \
                     label.color=0xfff8fafc \
                     icon.color=0xff7aa2f7

# Space indicators
for i in 1 2 3 4 5 6; do
  sketchybar --add space space.$i left \
             --set space.$i space=$i \
                            icon=$i \
                            label.padding_right=8
done

# Right side widgets
sketchybar --add item clock right \
           --set clock update_freq=10 script="date '+%H:%M %d %b'" \
           --add item battery right \
           --set battery update_freq=30 script="pmset -g batt | grep -Eo '[0-9]+%'"

sketchybar --update
